# Copy to .env and fill in your Supabase values.
# Supabase dashboard → Project → "Connect".

# Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session pooler (port 5432) — used by Prisma for db push & migrations.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage — used to store design attachments (files + standalone HTML
# exports). Project Settings → API for the URL and service role key. Create a
# PUBLIC bucket named "design-attachments" (or set SUPABASE_STORAGE_BUCKET).
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="design-attachments"

# Secret for signing session cookies.
AUTH_SECRET="change-me-to-a-long-random-string"

# Linear integration. Each designer connects their own Linear from
# /manage/settings (Personal API key, stored encrypted) — no global key needed.
# APP_BASE_URL is the public origin of this app, used to build the flow links
# posted to Linear. Designers without a key simply skip all Linear sync.
APP_BASE_URL="http://localhost:3000"
