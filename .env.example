# Copy to .env and fill in your Supabase values.
# Supabase dashboard → Project → "Connect".

# Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session pooler (port 5432) — used by Prisma for db push & migrations.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Google Drive (attachment storage) ────────────────────────────────
# Design attachments (files + standalone HTML exports) are stored in a Google
# Drive folder and streamed back through /api/files/[id]. Setup:
#   1. Google Cloud Console → IAM & Admin → Service Accounts → create one
#      (same project as the OAuth client below is fine), then Keys → Add key
#      → JSON. Copy client_email and private_key from the downloaded file.
#   2. Enable the "Google Drive API" for the project (APIs & Services).
#   3. In Google Drive, create a folder INSIDE A SHARED DRIVE (files in a
#      Shared Drive don't count against the service account's own tiny quota)
#      and share the folder — or the whole Shared Drive — with the service
#      account email as "Content manager".
#   4. The folder id is the last path segment of its Drive URL.
GOOGLE_SERVICE_ACCOUNT_EMAIL="[NAME]@[PROJECT].iam.gserviceaccount.com"
# Paste the private_key value as-is (one line, with the \n escapes).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# Secret for signing session cookies.
AUTH_SECRET="change-me-to-a-long-random-string"

# Linear integration. Each designer connects their own Linear from
# /manage/settings (Personal API key, stored encrypted) — no global key needed.
# APP_BASE_URL is the public origin of this app, used to build the flow links
# posted to Linear. Designers without a key simply skip all Linear sync.
APP_BASE_URL="http://localhost:3000"

# ─── Google OAuth (login) ─────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: <APP_BASE_URL>/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails promoted to admin on Google sign-in.
ADMIN_EMAILS=
